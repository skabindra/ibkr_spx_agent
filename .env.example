# IBKR Paper Trading - copy to .env and fill in
# NEVER use live credentials here unless explicitly enabling live override.

# TWS/IB Gateway connection (paper trading typically uses port 4002)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=

# Safety: set to true ONLY to allow live connection (default false = paper only)
IBKR_ALLOW_LIVE=false

# Optional: config file path (default: config.yaml in project root)
# CONFIG_PATH=config.yaml
